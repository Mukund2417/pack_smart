# PackSmart Backend Environment Variables
# Copy this file to .env and fill in real values

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for local development):
DATABASE_URL=sqlite:///./packsmart.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/packsmart

# ── Security ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# ── Vite Frontend ──────────────────────────────────────────────────────────────
# Set this in frontend/.env (not here) to configure the API base URL
# VITE_API_URL=http://localhost:8000

# ── TOPSIS Engine Weights (must sum to 1.0) ───────────────────────────────────
TOPSIS_W_BARRIER=0.35
TOPSIS_W_COST=0.25
TOPSIS_W_CARBON=0.20
TOPSIS_W_MECHANICAL=0.10
TOPSIS_W_SEAL=0.10
